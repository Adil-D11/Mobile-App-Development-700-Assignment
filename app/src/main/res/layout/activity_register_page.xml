<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/blue_gradient"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Register_Page">

    <TextView
        android:id="@+id/BodyTextView"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:text="REGISTER"
        android:textSize="27sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <ImageView
        android:id="@+id/RegisterImg"
        android:layout_width="370dp"
        android:layout_height="170dp"
        android:src="@drawable/startup_logo_2"
        android:scaleType="fitCenter"
        android:layout_marginTop="-21dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/BodyTextView"/>

    <LinearLayout
        android:id="@+id/Register"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/rounded_borders"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.7">


        <TextView
            android:id="@+id/RegisterEmailtxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email:"
            android:textSize="18sp"
            android:textStyle="italic"
            android:gravity="center"
            android:padding="10dp"
            />

        <EditText
            android:id="@+id/editEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ems="14"
            android:hint="example@gmail.com"
            android:inputType="textEmailAddress"
            android:imeOptions="actionNext"
            android:layout_marginStart="13dp"
            android:layout_marginEnd="13dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/RegisterEmailtxt" />


        <TextView
            android:id="@+id/RegisterUsernametxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Username:"
            android:textSize="18sp"
            android:textStyle="italic"
            android:gravity="center"
            android:padding="10dp"
            />

        <EditText
            android:id="@+id/editUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ems="14"
            android:hint="username"
            android:inputType="textPersonName"
            android:imeOptions="actionNext"
            android:layout_marginStart="13dp"
            android:layout_marginEnd="13dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/RegisterEmailtxt" />


        <TextView
            android:id="@+id/RegPasswordtxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Password:"
            android:textSize="18sp"
            android:textStyle="italic"
            android:gravity="center"
            android:padding="10dp"
            />

        <EditText
            android:id="@+id/editPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ems="14"
            android:hint="Minimum 8 Characters"
            android:inputType="textPassword"
            android:imeOptions="actionNext"
            android:layout_marginStart="13dp"
            android:layout_marginEnd="13dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/RegPasswordtxt" />

        <TextView
            android:id="@+id/RegConPasswordtxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Confirm Password:"
            android:textSize="18sp"
            android:textStyle="italic"
            android:gravity="center"
            android:padding="10dp"
            />

        <EditText
            android:id="@+id/editConPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ems="14"
            android:hint="Confirm Password"
            android:inputType="textPassword"
            android:imeOptions="actionNext"
            android:layout_marginStart="13dp"
            android:layout_marginEnd="13dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/RegPasswordtxt" />

        <Button
            android:id="@+id/btnReg"
            android:layout_width="130dp"
            android:layout_height="60dp"
            android:layout_marginTop="7dp"
            android:text="Register"
            android:textSize="20sp"
            android:backgroundTint="#2196C4"
            />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>